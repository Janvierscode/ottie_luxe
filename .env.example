# Public site address. Replace with the Vercel URL after first deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Settings > API. The publishable key is safe for browser use with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional privacy-friendly analytics. Leave blank to disable without affecting the site.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
